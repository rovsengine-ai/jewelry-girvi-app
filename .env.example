# Supabase project credentials (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Moonshot / Kimi OCR key lives in Supabase Edge Function secrets only:
#   supabase secrets set MOONSHOT_API_KEY=sk-...
# Do not put Moonshot keys in EXPO_PUBLIC_* vars.
#
# Gold feed keys (never EXPO_PUBLIC_*). Quotes are not IBJA.
#   supabase secrets set GOLDAPI_API_KEY=...
#   # or: supabase secrets set METALS_DEV_API_KEY=... GOLD_RATE_PROVIDER=metals_dev
# Local: supabase/functions/.env (gitignored).
