# Copy into gitignored files — never commit real keys.
#
#   cp .env.example .env.development   # then fill local Docker values
#   cp .env.example .env.production    # then fill hosted Dashboard values
#
# Expo loads by NODE_ENV (npx expo start → development; eas/export → production):
#   .env.development  or  .env.production
# Restart Metro after changing them (`npx expo start -c`).
#
# Do NOT flip local ↔ hosted by commenting lines in a single .env — that is how
# a shop writes real loans into Docker, or a test loan into production.

# --- required in both files ---
# development | production
EXPO_PUBLIC_ENV=development

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- .env.development (local CLI) ---
# Copy URL and anon key from `npx supabase status`.
# Test accounts (9000000001 / 123456 etc.) exist only here, not on hosted.
# Simulator / same Mac:  http://127.0.0.1:54321
# Physical phone on same Wi‑Fi: use the Mac LAN IP (same host as exp://… QR),
#   e.g. http://192.168.1.10:54321 — 127.0.0.1 on the phone is the phone itself.
# EXPO_PUBLIC_ENV=development
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- .env.production (hosted) ---
# Dashboard → Project Settings → API. Do not use README test phones remotely.
# EXPO_PUBLIC_ENV=production
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OCR — Edge Function secrets only (never EXPO_PUBLIC_*).
# Local:  cp supabase/functions/.env.example supabase/functions/.env
#         Prefer free Gemini: GEMINI_API_KEY from https://aistudio.google.com/apikey
#         Or paid Kimi: MOONSHOT_API_KEY=sk-... then `npx supabase stop && npx supabase start`
# Hosted: npx supabase secrets set GEMINI_API_KEY=...
# China Moonshot keys: also set MOONSHOT_API_BASE_URL=https://api.moonshot.cn/v1

# Customer website origin for loan (/g/…) and activation (/a/…) QR URLs.
# No trailing slash. Production: your Vercel domain. Local web: http://localhost:8081
# EXPO_PUBLIC_WEB_ORIGIN=https://girvi-sewa.vercel.app
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:8081

# Android chrome blur. dimezisBlurViewSdk31Plus on SDK 31+; older falls back.
# Scanner sets androidBlur on GlassSurface even when this is unset.
EXPO_PUBLIC_ENABLE_ANDROID_BLUR=true

# Customer sign-in: pin (default, SMS-free) | otp (MSG91 / Twilio later).
# EXPO_PUBLIC_AUTH_MODE=pin
EXPO_PUBLIC_AUTH_MODE=pin
