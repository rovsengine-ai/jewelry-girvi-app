# Supabase project credentials (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Moonshot / Kimi OCR key lives in Supabase Edge Function secrets only:
#   supabase secrets set MOONSHOT_API_KEY=sk-...
# Do not put Moonshot keys in EXPO_PUBLIC_* vars.
