# Local CLI — copy URL and anon key from `npx supabase status`.
# Test accounts (9000000001 / 123456 etc.) exist only here, not on hosted.
# Restart Metro after changing these (`npx expo start -c`).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hosted project (Dashboard → Project Settings → API). Do not use with README
# test phones — those users are never seeded remotely.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Moonshot / Kimi OCR key lives in Supabase Edge Function secrets only:
#   supabase secrets set MOONSHOT_API_KEY=sk-...
# Do not put Moonshot keys in EXPO_PUBLIC_* vars.
#
# There is no live gold feed / GoldAPI. Pledge valuation uses manual
# gold_rates rows (seed or set_manual_gold_rate). Quotes are never IBJA.

# Android chrome blur. Default off — dimezisBlurView costs frames on
# low-end / SDK 30 and below. SDK 57 prop is blurMethod, not experimentalBlurMethod.
# EXPO_PUBLIC_ENABLE_ANDROID_BLUR=true
