# Loaded automatically on `supabase start`. Copy to `.env` (gitignored).
#
# --- Option A (recommended, free tier): Google Gemini ---
# Key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# Optional model override (default gemini-3.6-flash):
# GEMINI_MODEL=gemini-3.5-flash-lite
#
# --- Option B: Kimi Open Platform (paid / billed) ---
# Key from https://platform.kimi.ai/console/api-keys (Secret Key sk-...)
# MOONSHOT_API_KEY=sk-your-key-here
#
# China platform only:
# MOONSHOT_API_BASE_URL=https://api.moonshot.cn/v1
#
# --- Option C: Modal shared / dedicated Kimi endpoint ---
# NOT https://modal.com — use the endpoint URL from Modal dashboard or:
#   modal endpoint list
# Example shape: https://your-workspace--kimi-k3.modal.run
# MOONSHOT_API_BASE_URL=https://your-workspace--kimi-k3.modal.run/v1
# Proxy token from `modal token new` — join as wk-ID.ws-SECRET (one string, dot not colon):
# MOONSHOT_API_KEY=wk-your-token-id.ws-your-token-secret
# Modal catalog model id (not kimi-k3):
# MOONSHOT_MODEL=moonshotai/Kimi-K3
#
# If both GEMINI_API_KEY and MOONSHOT_API_KEY are set, Gemini is used.
