{
  "expo": {
    "name": "jewelry-girvi-app",
    "slug": "jewelry-girvi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jewelrygirviapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Girvi Shop to scan handwritten receipt pads."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "loan-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Girvi Shop to attach pledged-item and KYC photos.",
          "cameraPermission": "Allow Girvi Shop to photograph pledged items and ID documents.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
